# Релизный образ staging/prod: backend + собранный фронтенд (раздаётся FastAPI).
# Фронтенд собирается ДО docker build (deploy/deploy.sh): frontend/dist → /code/static.
# Один образ проходит staging и промоутится на prod без пересборки.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Библиотеки WeasyPrint (PDF) + шрифты с кириллицей
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /code

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY alembic.ini .
COPY migrations ./migrations
COPY app ./app
COPY frontend/dist ./static

EXPOSE 8000

# Миграции при старте (аддитивные в один релиз — см. CLAUDE.md 7.4);
# перед prod-миграцией promote.sh делает автодамп БД
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2"]
