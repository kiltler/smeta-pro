# Шаблон /opt/smeta-pro/.env.prod (НА СЕРВЕРЕ, в git не попадает!)
# Секреты prod и staging РАЗНЫЕ (CLAUDE.md 7.7).
APP_ENV=prod
# Длинная случайная строка: openssl rand -hex 32
SECRET_KEY=ЗАМЕНИТЬ

POSTGRES_USER=smeta
POSTGRES_PASSWORD=ЗАМЕНИТЬ
POSTGRES_DB=smeta

S3_ACCESS_KEY=smeta-prod
S3_SECRET_KEY=ЗАМЕНИТЬ
S3_BUCKET=smeta
S3_SECURE=false

PARSE_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Боевой SMS-провайдер появится отдельной задачей; пока коды в логах
SMS_PROVIDER=stub
SMS_API_KEY=

# ЮKassa: на prod — БОЕВОЙ магазин. Вебхук в кабинете:
# https://app.<домен>/billing/webhook (события payment.succeeded, payment.canceled)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PRO_PRICE_RUB=790
FREE_DOC_LIMIT=3
BILLING_GRACE_DAYS=3
BILLING_RETURN_URL=https://app.ЗАМЕНИТЬ-ДОМЕН/#/profile
