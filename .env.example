# ==========================================================================
# СметаПро — переменные окружения (локальная разработка)
# Скопируйте в .env:  cp .env.example .env
# Файл .env не коммитится (см. .gitignore).
# ==========================================================================

# --- Приложение -----------------------------------------------------------
# Окружение: local | staging | prod
APP_ENV=local
# Порт, на котором API доступен на хост-машине
APP_PORT=8000
# Секретный ключ приложения (подпись JWT и т.п.). В проде — длинная случайная строка!
SECRET_KEY=dev-secret-change-me

# --- PostgreSQL -----------------------------------------------------------
# Эти три переменные использует контейнер postgres при первом старте
POSTGRES_USER=smeta
POSTGRES_PASSWORD=smeta
POSTGRES_DB=smeta
# Полный URL подключения для приложения и Alembic.
# Внутри docker-сети хост — "db"; при запуске приложения без Docker — "localhost".
DATABASE_URL=postgresql+psycopg://smeta:smeta@db:5432/smeta

# --- Хранилище файлов (S3-совместимое, локально — MinIO) -------------------
# Адрес S3 API изнутри docker-сети (без схемы http/https)
S3_ENDPOINT=minio:9000
# Ключи доступа (для локального MinIO задают логин/пароль root-пользователя)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Имя бакета для файлов проекта (логотипы, PDF, дампы). Создаётся автоматически при старте API.
S3_BUCKET=smeta
# true — если хранилище доступно по HTTPS (в проде), false — для локального MinIO
S3_SECURE=false
# Порт веб-консоли MinIO на хост-машине (только для локальной разработки)
MINIO_CONSOLE_PORT=9001

# --- Anthropic API (ИИ-парсер диктовок) -------------------------------------
# Включает режимы «Голос» и «Текст» (нужны ключ и кредиты на аккаунте Anthropic).
# false — работает только режим «Шаблоны», /parse отвечает 503
PARSE_ENABLED=false
# Ключ из https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Модель парсера (стек проекта фиксирует sonnet)
ANTHROPIC_MODEL=claude-sonnet-5

# --- Вход по телефону (SMS-код + JWT) ---------------------------------------
# Провайдер отправки кодов: stub (код пишется в лог) | реальный провайдер позже
SMS_PROVIDER=stub
SMS_API_KEY=
# Время жизни SMS-кода, минут
AUTH_CODE_TTL_MINUTES=5
# Максимум запросов кода на один номер в час
AUTH_RATE_LIMIT_PER_HOUR=3
# Время жизни JWT-токена, дней (вход с телефона на объекте — токен долгоживущий)
JWT_TTL_DAYS=30

# --- ЮKassa (задача 7 — биллинг) -------------------------------------------
# Идентификатор магазина и секретный ключ из личного кабинета ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
