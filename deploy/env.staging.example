# Шаблон /opt/smeta-pro/.env.staging (НА СЕРВЕРЕ, в git не попадает!)
# Секреты staging и prod РАЗНЫЕ (CLAUDE.md 7.7).
APP_ENV=staging
# Длинная случайная строка: openssl rand -hex 32
SECRET_KEY=ЗАМЕНИТЬ

POSTGRES_USER=smeta
POSTGRES_PASSWORD=ЗАМЕНИТЬ
POSTGRES_DB=smeta

S3_ACCESS_KEY=smeta-staging
S3_SECRET_KEY=ЗАМЕНИТЬ
S3_BUCKET=smeta
S3_SECURE=false

# ИИ-парсер: включать только при наличии ключа и кредитов Anthropic
PARSE_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

SMS_PROVIDER=stub
SMS_API_KEY=

# ЮKassa: на staging — ТЕСТОВЫЙ магазин (shop_id и ключ из раздела
# «Тестовый магазин» кабинета ЮKassa). Вебхук в кабинете тестового магазина:
# https://staging.<домен>/billing/webhook (события payment.succeeded, payment.canceled)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PRO_PRICE_RUB=790
FREE_DOC_LIMIT=3
BILLING_GRACE_DAYS=3
BILLING_RETURN_URL=https://staging.ЗАМЕНИТЬ-ДОМЕН/#/profile
